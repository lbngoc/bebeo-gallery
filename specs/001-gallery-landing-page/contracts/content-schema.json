{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bebeo.gallery/contracts/content-schema.json",
  "title": "BeBeo Gallery Content Contract",
  "description": "Hop dong du lieu giua nguoi bien tap noi dung (chinh sua file JSON thu cong) va trang landing page. Duoc scripts/validate-content.mjs thuc thi khi build (npm run build).",
  "type": "object",
  "properties": {
    "albums": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/album" }
    },
    "videos": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/featuredVideo" }
    }
  },
  "$defs": {
    "album": {
      "type": "object",
      "required": ["id", "title", "location", "date", "categories", "thumbnail", "cloudUrl"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
        "description": { "type": "string" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "thumbnail": { "type": "string", "minLength": 1 },
        "cloudUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "cloudProvider": { "type": "string", "enum": ["google-drive", "pcloud", "other"] }
      }
    },
    "featuredVideo": {
      "type": "object",
      "required": ["id", "title", "poster", "sourceType", "embedRef", "fallbackUrl"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "poster": { "type": "string", "minLength": 1 },
        "sourceType": { "type": "string", "enum": ["youtube", "google-drive", "pcloud"] },
        "embedRef": { "type": "string", "minLength": 1 },
        "fallbackUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "order": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "x-validation-notes": [
    "id phai duy nhat trong toan bo albums.json (rieng) va videos.json (rieng).",
    "categories cua tat ca album gop lai (unique, sorted) chinh la danh sach filter hien thi o Gallery — xem data-model.md muc Category.",
    "Neu mot ban ghi khong thoa schema nay, scripts/validate-content.mjs MUST lam that bai build (FR-015 chi ap dung cho loi runtime/hien thi, khong thay the buoc validate build-time nay)."
  ]
}
