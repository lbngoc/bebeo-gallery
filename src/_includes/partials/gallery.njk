<div
  x-data='galleryFilter({{ albums | dump | safe }})'
  class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24"
>
  <div class="mb-8 flex flex-col gap-3 text-center sm:mb-10">
    <h2 class="text-3xl font-bold text-water-800 dark:text-earth-50 sm:text-4xl">Album ảnh gia đình</h2>
    <p class="text-water-700/80 dark:text-earth-100/80">Chạm vào một album để mở toàn bộ ảnh gốc trên cloud.</p>
  </div>

  <div class="mb-8 flex flex-wrap items-center justify-center gap-2 sm:mb-10" role="group" aria-label="Lọc album theo chủ đề">
    <button
      type="button"
      @click="select('all')"
      :aria-pressed="active === 'all'"
      :class="active === 'all' ? 'bg-water-600 text-earth-50 dark:bg-earth-400 dark:text-water-900' : 'bg-water-100 text-water-700 hover:bg-water-200 dark:bg-water-800 dark:text-earth-100 dark:hover:bg-water-700'"
      class="rounded-full px-4 py-2 text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-500"
    >
      Tất cả
    </button>
    {% for category in categories %}
    <button
      type="button"
      @click="select('{{ category }}')"
      :aria-pressed="active === '{{ category }}'"
      :class="active === '{{ category }}' ? 'bg-water-600 text-earth-50 dark:bg-earth-400 dark:text-water-900' : 'bg-water-100 text-water-700 hover:bg-water-200 dark:bg-water-800 dark:text-earth-100 dark:hover:bg-water-700'"
      class="rounded-full px-4 py-2 text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-500"
    >
      {{ category }}
    </button>
    {% endfor %}
  </div>

  <p x-show="!hasVisible" x-cloak class="py-12 text-center text-water-700/70 dark:text-earth-100/70">
    Không có album nào thuộc chủ đề này.
  </p>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {% asyncEach album in albums %}
    <div x-show="isVisible({{ loop.index0 }})">
      {% include "partials/album-card.njk" %}
    </div>
    {% endeach %}
  </div>
</div>
