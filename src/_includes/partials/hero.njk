{% heroBackground heroBackground %}

<div class="relative z-10 flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center gap-6 px-4 py-16 text-center sm:px-6 lg:min-h-[calc(100vh-5rem)]">
  <span class="text-sm font-semibold uppercase tracking-[0.3em] text-water-700 drop-shadow-sm dark:text-water-200">
    Chào mừng đến với
  </span>
  <h1 class="font-hand text-5xl text-water-800 drop-shadow-sm dark:text-earth-100 sm:text-6xl lg:text-7xl">
    BeBeo Gallery
  </h1>
  <p class="max-w-xl text-balance text-lg text-water-900/90 drop-shadow-sm dark:text-earth-50/90 sm:text-xl">
    Nơi lưu giữ và chia sẻ những khoảnh khắc ảnh, video đáng nhớ của gia đình —
    gọn gàng, ấm áp, và luôn dễ tìm lại.
  </p>
  <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
    <a
      href="#gallery"
      class="rounded-full bg-water-600 px-6 py-3 text-sm font-semibold text-earth-50 shadow-sm transition hover:bg-water-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-500 dark:bg-earth-400 dark:text-water-900 dark:hover:bg-earth-300"
    >
      Xem album ảnh
    </a>
    <a
      href="#video"
      class="rounded-full border border-water-300 bg-earth-50/40 px-6 py-3 text-sm font-semibold text-water-800 backdrop-blur transition hover:bg-water-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-500 dark:border-earth-300/50 dark:bg-water-900/30 dark:text-earth-100 dark:hover:bg-water-800"
    >
      Xem video nổi bật
    </a>
  </div>
</div>
