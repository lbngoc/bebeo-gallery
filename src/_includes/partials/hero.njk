{% heroBackground heroBackground %}
{% set hasPhoto = heroBackground.image %}

{% if hasPhoto %}
<div class="absolute inset-0 z-[5] hero-scrim" aria-hidden="true"></div>
{% endif %}

<div class="relative z-10 flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center gap-6 px-4 py-16 text-center sm:px-6 lg:min-h-[calc(100vh-5rem)]">
  {# Khi Hero dùng ảnh nền thật, chữ luôn dùng tông sáng (như dark mode) bất kể
     theme sáng/tối đang chọn — ảnh không đổi theo theme nên chữ cũng không nên
     đổi, để luôn đủ tương phản trên lớp hero-scrim (T019). #}
  <span class="text-sm font-semibold uppercase tracking-[0.3em] drop-shadow-sm {% if hasPhoto %}text-water-200{% else %}text-water-700 dark:text-water-200{% endif %}">
    Chào mừng đến với
  </span>
  <h1 class="font-hand text-5xl drop-shadow-sm sm:text-6xl lg:text-7xl {% if hasPhoto %}text-earth-100{% else %}text-water-800 dark:text-earth-100{% endif %}">
    BeBeo Gallery
  </h1>
  <p class="max-w-xl text-balance text-lg drop-shadow-sm sm:text-xl {% if hasPhoto %}text-earth-50/90{% else %}text-water-900/90 dark:text-earth-50/90{% endif %}">
    Nơi lưu giữ và chia sẻ những khoảnh khắc ảnh, video đáng nhớ của gia đình —
    gọn gàng, ấm áp, và luôn dễ tìm lại.
  </p>
  <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
    <a
      href="#gallery"
      class="rounded-full px-6 py-3 text-sm font-semibold shadow-sm transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-500 {% if hasPhoto %}bg-earth-400 text-water-900 hover:bg-earth-300{% else %}bg-water-600 text-earth-50 hover:bg-water-700 dark:bg-earth-400 dark:text-water-900 dark:hover:bg-earth-300{% endif %}"
    >
      Xem album ảnh
    </a>
    <a
      href="#video"
      class="rounded-full border px-6 py-3 text-sm font-semibold backdrop-blur transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-500 {% if hasPhoto %}border-earth-300/50 bg-water-900/30 text-earth-100 hover:bg-water-800{% else %}border-water-300 bg-earth-50/40 text-water-800 hover:bg-water-100 dark:border-earth-300/50 dark:bg-water-900/30 dark:text-earth-100 dark:hover:bg-water-800{% endif %}"
    >
      Xem video nổi bật
    </a>
  </div>
</div>
